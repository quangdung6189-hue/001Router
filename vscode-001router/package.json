{
  "name": "001router-code",
  "displayName": "001Router",
  "description": "Autonomous AI Coding Agent powered by 001Router — Grok 3D Singularity Core, Precision Effort Rail, Multi-Project Switcher, Cline-Grade Task Trace & Granular Permissions.",
  "version": "1.6.0",
  "publisher": "001router",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/quangdung6189-hue/001Router",
  "repository": {
    "type": "git",
    "url": "https://github.com/quangdung6189-hue/001Router.git"
  },
  "bugs": {
    "url": "https://github.com/quangdung6189-hue/001Router/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "001router",
    "ai",
    "coding-assistant",
    "autonomous-agent",
    "claude",
    "openai",
    "gemini",
    "antigravity",
    "deepseek",
    "grok",
    "openrouter"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:001router.chatView",
    "onCommand:001router.openPanel",
    "onCommand:001router.connect",
    "onCommand:001router.focus",
    "onCommand:001router.newChat",
    "onCommand:001router.syncEnv"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "001router-sidebar",
          "title": "001Router",
          "icon": "media/icon-activity.svg"
        }
      ]
    },
    "views": {
      "001router-sidebar": [
        {
          "type": "webview",
          "id": "001router.chatView",
          "name": "001Router"
        }
      ]
    },
    "commands": [
      {
        "command": "001router.openPanel",
        "title": "Open in Editor Tab",
        "category": "001Router",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "001router.focus",
        "title": "Focus or Unfocus Input",
        "category": "001Router"
      },
      {
        "command": "001router.connect",
        "title": "Connect with Web Password",
        "category": "001Router",
        "icon": "$(key)"
      },
      {
        "command": "001router.newChat",
        "title": "New Chat",
        "category": "001Router",
        "icon": "$(add)"
      },
      {
        "command": "001router.syncEnv",
        "title": "Sync Antigravity, CLI & VS Code",
        "category": "001Router",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "001router.openPanel",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "001router.openPanel",
          "when": "view == 001router.chatView",
          "group": "navigation"
        },
        {
          "command": "001router.connect",
          "when": "view == 001router.chatView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "001router.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      }
    ],
    "configuration": {
      "title": "001Router",
      "properties": {
        "001router.defaultServerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:20128",
          "description": "Default 001Router web server URL (e.g. http://127.0.0.1:20128 or your deployed 001Router domain)."
        }
      }
    }
  },
  "scripts": {
    "package:vsix": "node ./scripts/pack-vsix.js",
    "publish:ovsx": "npx ovsx publish ./001router-code-1.6.0.vsix",
    "publish:vsce": "npx @vscode/vsce publish"
  }
}
