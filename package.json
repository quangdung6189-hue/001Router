{
  "name": "001router",
  "version": "1.0.0",
  "description": "Local AI router & gateway compatible with OpenAI and Anthropic APIs (official API keys by default; experimental Gemini CLI / Antigravity sign-in)",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "security:scan": "node scripts/security-scan.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "nanoid": "^5.1.5",
    "pg": "^8.23.1",
    "undici": "^8.13.1"
  }
}
